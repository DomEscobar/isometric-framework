    {
      "id": "relationships-desktop",
      "requirements": [
        "relationships"
      ],
      "view": "desktop",
      "reference": "host/art/target.png",
      "role": "style",
      "focus": "Coherent region and object families, including the strongest repeated motif across all scenery in scope; a style-only reference does not prescribe exact placement"
