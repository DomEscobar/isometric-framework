    "host",
    "PROJECT_CONTRACT.md"
  ],
  "artChecks": [
    "host/packed-art.json"
  ],
  "reviewMode": "independent",
  "requirements": [
    {
      "id": "style",
      "domain": "visual",
      "description": "Approved pixel treatment, palette, light and player readability across the complete requested scene",
      "views": [
        "desktop",
        "mobile"
      ]
    },
    {
      "id": "composition",
      "domain": "visual",
      "description": "Whole-scene spatial hierarchy gives routes, open ground, landmarks and dense areas deliberate readable roles",
      "views": [
        "desktop",
        "mobile",
        "ground-only"
      ]
    },
    {
      "id": "relationships",
      "domain": "visual",
      "description": "Region and object families remain coherent, with intentional repeated motifs across all scenery in scope",
      "views": [
        "desktop",
        "mobile"
      ]
    },
    {
      "id": "connections",
      "domain": "visual",
      "description": "Objects visibly join their supporting ground and adjacent materials through deliberate roots, foundations, banks, paths and entrances",
      "views": [
        "desktop",
        "mobile",
        "contact-detail"
      ]
    },
    {
      "id": "motion",
      "domain": "motion",
      "description": "Every promised scenery and actor cycle has stable contacts, continuous joins and correct pause behavior",
      "views": [
        "desktop",
        "mobile"
      ]
    },
    {
      "id": "play",
      "domain": "gameplay",
      "description": "Requested connected routes and interactions work with real desktop and touch input",
      "views": [
        "desktop",
        "mobile"
      ]
    },
    {
      "id": "timing",
      "domain": "performance",
      "description": "Frame intervals measured against the agreed budget with renderer, viewport and blank baseline recorded",
      "views": [
        "desktop",
        "mobile"
      ]
    }
  ],
  "comparisons": [
    {
      "id": "style-desktop",
      "requirements": [
        "style"
      ],
      "view": "desktop",
      "reference": "host/art/target.png",
      "role": "style",
      "focus": "Approved pixel treatment, palette, light and readable player scale; a style-only reference does not require copied positions"
    },
    {
      "id": "style-mobile",
      "requirements": [
        "style"
      ],
      "view": "mobile",
      "reference": "host/art/target.png",
      "role": "style",
