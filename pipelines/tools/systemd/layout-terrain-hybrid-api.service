[Unit]
Description=Local Hybrid Terrain api
After=network.target
[Service]
Type=simple
WorkingDirectory=/root/services/layout-terrain-pipeline
ExecStart=/usr/bin/python3 -m uvicorn hybrid_api:create_app --factory --host 127.0.0.1 --port 48765 --no-access-log
Environment=HYBRID_DATA=/root/services/layout-terrain-pipeline/data
EnvironmentFile=-/root/.config/layout-terrain-hybrid/environment
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
