      "view": "mobile",
      "reference": "host/art/target.png",
      "role": "style",
      "focus": "Coherent region and object families remain legible at mobile scale, including intentional repetition across all scenery in scope"
    },
    {
      "id": "connections-desktop",
      "requirements": [
        "connections"
      ],
      "view": "desktop",
      "reference": "host/art/target.png",
      "role": "style",
      "focus": "Visible object and material joins at roots, foundations, banks, paths and entrances; a style-only reference does not prescribe exact placement"
    },
    {
      "id": "connections-mobile",
      "requirements": [
        "connections"
      ],
      "view": "mobile",
      "reference": "host/art/target.png",
      "role": "style",
      "focus": "Visible object and material joins remain legible at mobile scale, especially active paths and entrances"
    },
    {
      "id": "connections-contact-detail",
      "requirements": [
        "connections"
      ],
      "view": "contact-detail",
      "reference": "host/art/target.png",
      "role": "style",
      "focus": "Close contact detail shows roots, foundations, banks, paths or entrances joined to their support without floating seams or pasted-on edges"
    }
