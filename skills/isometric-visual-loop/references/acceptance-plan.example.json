    },
    {
      "id": "composition-desktop",
      "requirements": [
        "composition"
      ],
      "view": "desktop",
      "reference": "host/art/target.png",
      "role": "style",
      "focus": "Whole-scene hierarchy: landmarks, routes, open ground and dense areas have readable intentional roles; a style-only reference does not prescribe exact placement"
