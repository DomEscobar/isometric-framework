{
  "version": 3,
  "root": "..",
  "contract": "PROJECT_CONTRACT.md",
  "inputRoots": [
    "host",
    "PROJECT_CONTRACT.md"
  ],
  "artChecks": [
    "host/packed-art.json"
  ],
  "reviewMode": "independent",
  "requirements": [
    {
      "id": "style",
      "domain": "visual",
      "description": "Approved style, terrain contacts and player readability across the complete requested scene",
      "views": [
        "desktop",
        "mobile"
      ]
    },
    {
      "id": "motion",
      "domain": "motion",
      "description": "Every promised scenery and actor cycle has stable contacts, continuous joins and correct pause behavior",
      "views": [
        "desktop",
        "mobile"
      ]
    },
    {
      "id": "play",
      "domain": "gameplay",
      "description": "Requested connected routes and interactions work with real desktop and touch input",
      "views": [
        "desktop",
        "mobile"
      ]
    },
    {
      "id": "timing",
      "domain": "performance",
      "description": "Frame intervals measured against the agreed budget with renderer, viewport and blank baseline recorded",
      "views": [
        "desktop",
        "mobile"
      ]
    }
  ],
  "comparisons": [
    {
      "id": "style-desktop",
      "requirements": [
        "style"
      ],
      "view": "desktop",
      "reference": "host/art/target.png",
      "role": "style",
      "focus": "Approved pixel treatment, material connections, hierarchy and readable traversal; layout need not copy a style-only reference"
    },
    {
      "id": "style-mobile",
      "requirements": [
        "style"
      ],
      "view": "mobile",
      "reference": "host/art/target.png",
      "role": "style",
      "focus": "Approved pixel treatment, material connections, hierarchy and readable traversal; layout need not copy a style-only reference"
    }
  ],
  "production": {
    "version": 1,
    "rigidAssets": [
      "market"
    ],
    "checks": [
      {
        "id": "preflight",
        "stage": "preflight",
        "method": "review",
        "requirements": [
          "style"
        ],
        "views": [
          "desktop"
        ],
        "inputs": [
          "host/startup.ts",
          "host/asset-smoke.json",
          "host/art/calibration.png"
        ],
        "evidenceKind": "measurement"
      },
      {
        "id": "layout",
        "stage": "layout",
        "method": "layout",
        "requirements": [
          "style"
        ],
        "views": [
          "desktop"
        ],
        "inputs": [
          "host/layout.json"
        ],
        "evidenceKind": "measurement",
        "source": "host/layout.json",
        "requiredScope": {
          "regions": [
            "land",
            "garden",
            "water"
          ],
          "instances": [
            "tree",
            "house"
          ],
          "routes": [
            "main"
          ],
          "bridges": [
