[Unit]
Description=Local Hybrid Terrain worker
After=network.target
[Service]
Type=simple
WorkingDirectory=/root/services/layout-terrain-pipeline
ExecStart=/usr/bin/python3 hybrid_worker.py
Environment=HYBRID_DATA=/root/services/layout-terrain-pipeline/data
EnvironmentFile=-/root/.config/layout-terrain-hybrid/environment
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
[Install]
WantedBy=multi-user.target
