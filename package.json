{
  "name": "isometric-framework",
  "version": "0.1.0",
  "type": "module",
  "description": "TypeScript isometric game framework with playable examples and agent authoring skills",
  "main": "./dist/runtime.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/runtime.js"
    },
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.js"
    },
    "./art": {
      "types": "./dist/types/art.d.ts",
      "import": "./dist/art.js"
    }
  },
  "files": [
    "dist",
    "templates/game",
    "docs/ART_PIPELINE.md",
    "docs/AUTOTILING.md",
    "docs/CREATE_GAME.md",
    "docs/DEBUGGING.md",
    "docs/INTERACTIONS.md",
    "docs/INVENTORY_AND_SAVES.md",
    "docs/RUNTIME_API.md",
    "skills/README.md",
    "skills/animated-environments/SKILL.md",
    "skills/animated-environments/references",
    "skills/animated-environments/scripts",
    "skills/consistent-tileset-authoring/SKILL.md",
    "skills/consistent-tileset-authoring/references",
    "skills/consistent-tileset-authoring/scripts",
    "skills/directional-sprite-authoring/SKILL.md",
    "skills/directional-sprite-authoring/references",
    "skills/directional-sprite-authoring/scripts",
    "skills/game-asset-generation/SKILL.md",
    "skills/game-asset-generation/references",
    "skills/game-asset-generation/scripts",
    "skills/isometric-art-integration/SKILL.md",
    "skills/isometric-art-integration/references",
    "skills/isometric-art-integration/scripts",
    "skills/isometric-visual-loop/SKILL.md",
    "skills/isometric-visual-loop/NOTICE.txt",
    "skills/isometric-visual-loop/references",
    "skills/isometric-visual-loop/scripts",
    "skills/multi-tile-asset-assembly/SKILL.md",
    "skills/multi-tile-asset-assembly/references",
    "skills/multi-tile-asset-assembly/scripts",
    "README.md",
    "PROVENANCE.md"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4175 --strictPort",
    "check": "npm run check:boundaries && tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "build": "npm run check && vite build && vite build --config vite.demo.config.ts && tsc --project tsconfig.build.json",
    "build:package": "npm run check && vite build && tsc --project tsconfig.build.json && npm pack",
    "create-game": "node scripts/create-game.mjs",
    "preview": "vite preview --outDir demo-dist --host 127.0.0.1 --port 4175 --strictPort",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:art-skill": "node --test skills/isometric-art-integration/tests/*.test.mjs",
    "test:asset-generation": "node --test skills/game-asset-generation/tests/*.test.mjs",
    "test:browser": "node tests/run-browser.mjs",
    "test:starter": "node --test tests/create-game.test.mjs"
  },
  "dependencies": {
    "pixi.js": "6.5.9"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "playwright": "1.58.2",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
